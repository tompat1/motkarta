{
  "name": "stockholm-independent-food-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite",
    "build": "bash scripts/build-verified.sh",
    "start": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:gate": "npm run typecheck && npm run lint && npm test && npm run test:python && npm run test:e2e",
    "test:all": "npm run test:gate",
    "test:e2e": "bash scripts/run-e2e-tests.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:python": "bash scripts/run-python-tests.sh",
    "mvp:fetch": ".venv/bin/python scripts/fetch_osm.py",
    "mvp": ".venv/bin/python scripts/run_mvp_pipeline.py",
    "mvp:query": ".venv/bin/python scripts/query_concierge.py",
    "geojson:extract": ".venv/bin/python scripts/geojson_extractor.py outputs/stockholm_food_places.geojson outputs/motkarta_rag_payload.json",
    "api:serve": ".venv/bin/python scripts/api_endpoint.py",
    "food-control:fetch": ".venv/bin/python scripts/fetch_food_control.py",
    "photos:fetch": ".venv/bin/python scripts/fetch_place_photos.py",
    "tasstipset:fetch": ".venv/bin/python scripts/fetch_tasstipset_dog_places.py",
    "food-control:match": ".venv/bin/python scripts/match_food_control.py",
    "permits:match": ".venv/bin/python scripts/match_serving_permits.py",
    "enrich:addresses": ".venv/bin/python scripts/google_places_monthly_sync.py",
    "enrich:photos": ".venv/bin/python scripts/fetch_place_photos.py --only-missing --validate",
    "enrich:catalog": ".venv/bin/python execution/enrich_catalog.py --output data/enrichment_overlay.json --scrape",
    "enrich:apply": ".venv/bin/python execution/apply_enrichment.py",
    "enrich:all": "npm run enrich:addresses && npm run enrich:photos && npm run enrich:catalog && npm run enrich:apply",
    "enrich:audit": ".venv/bin/python execution/audit_google_places_monthly.py",
    "freshness:monthly": "python3 scripts/run_monthly_catalog_freshness.py",
    "candidates:build": "python3 scripts/build_candidate_queue.py",
    "candidates:seed": "node scripts/generate_candidate_import_sql.mjs",
    "reviews:labels": "node scripts/export_review_labels.mjs",
    "sync:labels": "node scripts/sync_review_labels.mjs",
    "guides:seed": "node scripts/generate_evidence_seed_sql.mjs examples/independent_guides.sample.json drizzle/seeds/seed-guides.sql",
    "typecheck": "tsc --noEmit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "node scripts/run-lint.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed:places": "node scripts/generate_seed_sql.mjs",
    "db:seed:osm": "node scripts/generate_osm_seed_sql.mjs",
    "db:seed:evidence": "node scripts/generate_evidence_seed_sql.mjs",
    "db:scores:combine": "node scripts/combine_score_export.mjs",
    "db:scores": "node scripts/generate_score_snapshot_sql.mjs",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name motkarta",
    "deploy:concierge-rate-gate": "wrangler deploy --config wrangler.concierge-rate-gate.toml",
    "preview:concierge-ai:prepare": "node execution/prepare_concierge_ai_preview.mjs",
    "preview:concierge-ai:prepare:hybrid": "node execution/prepare_concierge_ai_preview.mjs --hybrid",
    "preview:concierge-ai:smoke": "node execution/smoke_concierge_ai_preview.mjs",
    "preview:concierge-ai:smoke:hybrid": "node execution/smoke_concierge_ai_preview.mjs --hybrid"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/leaflet.markercluster": "^1.5.6",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Stockholm Independent Food Map"
}
