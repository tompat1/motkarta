# Baseline Environment Variables
# Copy this file to .env and configure secrets as needed.

# Application Keys
# API_KEY=your_key_here

# Concierge flags default to deterministic retrieval and template rendering.
# Use Cloudflare vars/bindings on the server; do not prefix secrets with VITE_.
# CONCIERGE_RETRIEVAL_MODE=lexical
# CONCIERGE_SYNTHESIS_MODE=template
# CONCIERGE_MIN_SIMILARITY=  # Set only after measured development-set calibration.
# Indexing --apply only; ordinary tests and dry-run never need these:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
